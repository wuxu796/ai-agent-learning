# 食鉴 配置
# 复制此文件为 .env 并修改

# LLM 提供者: deepseek（云端）或 ollama（本地）
LLM_PROVIDER=deepseek

# DeepSeek（仅 LLM_PROVIDER=deepseek 时需要）
DEEPSEEK_API_KEY=sk-your-key-here

# Ollama（仅 LLM_PROVIDER=ollama 时需要，默认值如下）
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_VISION_MODEL=qwen3-vl:8b     # 视觉识别（OCR）
# OLLAMA_TEXT_MODEL=qwen3:8b           # 文本解析（JSON结构化）
